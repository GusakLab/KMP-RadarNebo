<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} trace=%X{trace_id} span=%X{span_id} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- Fills trace_id and span_id from the current span. No-op when tracing is off. -->
    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.mdc.v1_0.OpenTelemetryAppender">
        <appender-ref ref="STDOUT"/>
    </appender>
    <root level="INFO">
        <appender-ref ref="OTEL"/>
    </root>
    <logger name="io.ktor" level="WARN"/>
</configuration>
