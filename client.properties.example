# Copy to client.properties (gitignored) and fill in. The build bakes these values into the client apps
# (Android, desktop, iOS) as their server; the apps have no setting to change it.
# Rebuild the app after changing this file.

# The RadarNebo server the apps connect to. Leave blank for https://radar-nebo.worxbend.com.
server.url=https://radar-nebo.worxbend.com
# The client key the server expects (one of its CLIENT_KEYS). Leave blank if the server needs none.
server.accessKey=
